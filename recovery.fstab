# OPPO A53 CPH2127 / OP4EFDL1
# Snapdragon 460 - Bengal
# Android 12 / ColorOS 12
# A-only, Dynamic Partitions

# Dynamic logical partitions
system          /system_root       erofs    ro                                      wait,logical
system          /system_root       ext4     ro                                      wait,logical

system_ext      /system_ext        erofs    ro                                      wait,logical
system_ext      /system_ext        ext4     ro                                      wait,logical

vendor          /vendor            erofs    ro                                      wait,logical
vendor          /vendor            ext4     ro                                      wait,logical

product         /product           ext4     ro                                      wait,logical
product         /product           erofs    ro                                      wait,logical

odm             /odm               erofs    ro                                      wait,logical
odm             /odm               ext4     ro                                      wait,logical

my_product      /my_product        erofs    ro                                      wait,logical
my_product      /my_product        ext4     ro                                      wait,logical

my_engineering  /my_engineering    erofs    ro                                      wait,logical
my_engineering  /my_engineering    ext4     ro                                      wait,logical

# Cache
/dev/block/by-name/cache       /cache       ext4    noatime,nosuid,nodev              wait

# Metadata
/dev/block/by-name/metadata    /metadata    ext4    noatime,nosuid,nodev,discard      wait

# Userdata - FBE / F2FS or EXT4
/dev/block/by-name/userdata    /data        f2fs    noatime,nosuid,nodev,discard,inlinecrypt    latemount,wait,check,formattable,fileencryption=ice,wrappedkey,quota
/dev/block/by-name/userdata    /data        ext4    noatime,nosuid,nodev,discard,inlinecrypt    latemount,wait,check,formattable,fileencryption=ice,wrappedkey,quota

# Physical partitions
/dev/block/by-name/boot        /boot        emmc    defaults    defaults
/dev/block/by-name/recovery    /recovery    emmc    defaults    defaults
/dev/block/by-name/dtbo        /dtbo        emmc    defaults    defaults
/dev/block/by-name/vbmeta      /vbmeta      emmc    defaults    defaults
/dev/block/by-name/modem       /modem       emmc    defaults    defaults
/dev/block/by-name/dsp         /dsp         emmc    defaults    defaults
/dev/block/by-name/tz          /tz          emmc    defaults    defaults
/dev/block/by-name/splash      /splash      emmc    defaults    defaults
/dev/block/by-name/misc        /misc        emmc    defaults    defaults
