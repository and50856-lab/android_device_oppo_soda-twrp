# Android fstab file.
# OPPO A53 CPH2127 / OP4EFDL1
# A-only device

# Mount point    fstype    device    flags
/boot            emmc      /dev/block/bootdevice/by-name/boot                    flags=backup=1;display="Boot";flashimg=1
/recovery        emmc      /dev/block/bootdevice/by-name/recovery                flags=backup=1;display="Recovery";flashimg=1
/dtbo            emmc      /dev/block/bootdevice/by-name/dtbo                    flags=backup=1;display="DTBO";flashimg=1
/vbmeta          emmc      /dev/block/bootdevice/by-name/vbmeta                  flags=backup=1;display="VBMeta";flashimg=1
/vbmeta_system   emmc      /dev/block/bootdevice/by-name/vbmeta_system           flags=backup=1;display="VBMeta System";flashimg=1
/vbmeta_vendor   emmc      /dev/block/bootdevice/by-name/vbmeta_vendor           flags=backup=1;display="VBMeta Vendor";flashimg=1

/efs1            emmc      /dev/block/bootdevice/by-name/modemst1                flags=backup=1;display="EFS"
/efs2            emmc      /dev/block/bootdevice/by-name/modemst2                flags=backup=1;display="EFS 2"

/modem           emmc      /dev/block/bootdevice/by-name/modem                   flags=backup=1;display="Modem"
/fsg             emmc      /dev/block/bootdevice/by-name/fsg                     flags=backup=1;display="FSG"
/bluetooth       emmc      /dev/block/bootdevice/by-name/bluetooth               flags=backup=1;display="Bluetooth"
/dsp             emmc      /dev/block/bootdevice/by-name/dsp                     flags=backup=1;display="DSP"
/tz              emmc      /dev/block/bootdevice/by-name/tz                      flags=backup=1;display="TZ"
/keymaster       emmc      /dev/block/bootdevice/by-name/keymaster               flags=backup=1;display="Keymaster"
/splash          emmc      /dev/block/bootdevice/by-name/splash                  flags=backup=1;display="Splash"

/external_sd     auto      /dev/block/mmcblk0p1                                  flags=display="Micro SD";storage;wipeingui;removable
/usb_otg         auto      /dev/block/sda1                                       flags=display="USB OTG";storage;wipeingui;removable
